# Copy to .env.local for local values (git-ignored, never committed).
# On Vercel, add the same names under Project → Settings → Environment Variables.

# REQUIRED FOR PRODUCTION. The real https origin, no trailing slash, e.g.
#   NEXT_PUBLIC_SITE_URL=https://www.her-domain.com
# Used for canonical URLs, Open Graph, sitemap.xml and robots.txt.
# - `pnpm build:production` (and Vercel production builds) FAIL without a real
#   https origin; example.com, localhost, .test and .example are rejected.
# - Any other build without one is noindex everywhere, with robots.txt
#   disallowing all and an empty sitemap.
# The domain is not confirmed yet: leave this unset until it is.
NEXT_PUBLIC_SITE_URL=

# ── Sanity CMS (docs/08-cms-guide.md) ─────────────────────────────────────
# Leave the project ID empty to keep using the local content files in
# src/content/artist/ (the site works exactly as before).

# Public by design (visible in the browser; not secret).
# From sanity.io/manage → your project. Lowercase letters and digits.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# SERVER ONLY. Never prefix these with NEXT_PUBLIC_ (the build refuses).
# Viewer token (sanity.io/manage → API → Tokens): Draft Mode preview only.
SANITY_API_READ_TOKEN=
# NOT NEEDED normally: `pnpm sanity:seed-collections` uses your own
# `sanity login`. Only for its --token alternative (a temporary Editor token,
# deleted afterwards). Never set on Vercel.
SANITY_API_WRITE_TOKEN=
# Long random string, identical in the Sanity webhook settings. Required for
# production builds with Sanity. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SANITY_REVALIDATE_SECRET=

# Sample-content preview (watermarked sample images, red banner, noindex).
# Use `pnpm preview:sample` instead of setting this by hand.
# NEVER set in production: `pnpm build:production` refuses it.
# ARTBYMOON_SAMPLE_CONTENT=1
